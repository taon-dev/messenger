{
  "json.schemas": [
    {
      "fileMatch": [
        "/taon.jsonc"
      ],
      "url": "./taon-config.schema.json"
    }
  ],
  "workbench.colorCustomizations": {
    "activityBar.background": "#2527ad",
    "statusBar.background": "#886030",
    "statusBar.debuggingBackground": "#15d8ff"
  },
  "files.watcherExclude": {
    "local_release/**": true,
    "tmp-*/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/src/**": true,
    "**/dist-nocutsrc/**": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[json5]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "editor.rulers": [
    80,
    120
  ],
  "eslint.migration.2_x": "off",
  "eslint.enable": true,
  "prettier.enable": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.inlineSuggest.enabled": true,
  "prettier.prettierPath": "./node_modules/prettier",
  "prettier.endOfLine": "auto",
  "typescript.suggest.autoImports": false,
  "javascript.suggest.autoImports": false,
  "files.associations": {
    "tsconfig.json": "plaintext",
    "**/tsconfig.json": "plaintext",
    "**/tsconfig.*.json": "plaintext"
  },
  "search.followSymlinks": false,
  "search.useIgnoreFiles": false,
  "search.include": [
    "**/src/**"
  ],
  "search.exclude": {
    "bin": true,
    "local_release": true,
    "node_modules": true,
    ".build": true,
    ".vscode": true,
    ".ai": true,
    "databases": true,
    "browser": true,
    "dist": true,
    "dist-*": true,
    "package-lock.json": true,
    "tmp-*": true,
    "*.rest": true,
    "**/bin": true,
    "**/local_release": true,
    "**/node_modules": true,
    "**/.build": true,
    "**/.vscode": true,
    "**/databases": true,
    "**/browser": true,
    "**/dist": true,
    "**/dist-*": true,
    "**/package-lock.json": true,
    "**/tmp-*": true,
    "**/*.rest": true,
    "projects": true,
    ".firedev": true,
    ".taon": true,
    ".tnp": true,
    "src/app.auto-gen-docs.md": true,
    "src/app.auto-gen-ver.js": true,
    "**/src/app.auto-gen-docs.md": true,
    "**/src/app.auto-gen-ver.js": true,
    "sub-projects": true
  },
  "window.title": "taon-dev/messenger () [ ${activeEditorShort}]",
  "files.exclude": {
    "_changelog": true,
    ".sass-cache": true,
    ".sourcemaps": true,
    ".DS_Store": true,
    "**/.DS_Store": true,
    "npm-debug.log": true,
    "yarn-error.log": true,
    "testem.log": true,
    "connect.lock": true,
    "node_modules": true,
    "libpeerconnection.log": true,
    "dist": true,
    "coverage": true,
    "Thumbs.db": true,
    "tmp-*": true,
    "**/tmp-*": true,
    "dist*": true,
    "**/dist*": true,
    "dist-*": true,
    "**/dist-*": true,
    "package.json": true,
    "websql": true,
    "browser": true,
    ".ai/examples": true,
    "sub-projects/**/tsconfig.json": true,
    "chrome-profiler-events*.json": true,
    "speed-measure-plugin*.json": true,
    "tmp*": true,
    "**/tmp*": true,
    "npm-debug.log*": true,
    "eslint-rules": true,
    "eslint.config.ts": true,
    "taon-config.schema.json": true,
    "AGENTS.md": true,
    ".github/copilot-instructions.md": true,
    ".ai": true,
    "index.js": true,
    "index.js.map": true,
    "index.d.ts": true,
    "vitest.config-browser.ts": true,
    "vitest.config-backend.ts": true,
    "vitest.setup-browser.ts": true,
    "vitest-angular-resources.plugin.ts": true,
    "run.js": true,
    "update-vscode-package-json.js": true,
    ".npmignore": true,
    ".babelrc": true,
    ".editorconfig": true,
    "eslint.config.js": true,
    "protractor.conf.js": true,
    "karma.conf.js": true,
    ".prettierc": true,
    "angular.json": true,
    ".prettierrc.json": true,
    ".eslintrc.js": true,
    ".eslintrc.json": true,
    ".npmrc": true,
    ".yarnrc": true,
    ".idea": true,
    ".prettierignore": true,
    ".prettierrc": true,
    "tsconfig*": true,
    "**/tsconfig*": true,
    "webpack.*": true,
    ".eslintrc*": true,
    "tslint.*": true,
    "!templates-subprojects/**/package.json": true
  }
}
